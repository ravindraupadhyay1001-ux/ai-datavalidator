{
  "manifest_version": 3,
  "name": "AI DataValidator — Web Extract",
  "version": "0.1.0",
  "description": "Extract a table from any web app (or capture its exported CSV/JSON) and send it straight to AI DataValidator — no backend access, uses your own logged-in session.",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "AI DataValidator — Web Extract",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
